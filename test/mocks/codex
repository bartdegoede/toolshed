#!/usr/bin/env bash
# Mock `codex` CLI for the e2e suite. toolshed only needs it on PATH (to know
# Codex is installed): it edits $CODEX_HOME/config.toml itself, because
# `codex mcp add` would reset the user's settings for a server. Anything else
# fails loudly, so the suite notices if toolshed starts depending on it.
set -euo pipefail
[[ "${1:-}" == "--version" ]] && { echo "codex-cli 0.0.0-mock"; exit 0; }
echo "mock codex: toolshed shouldn't need: codex $*" >&2
exit 1
